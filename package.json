{
  "name": "veilcast",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "detection-core",
    "main-backend",
    "ex-frontend"
  ],
  "scripts": {
    "dev": "bun main-backend/src/index.ts",
    "start": "NODE_ENV=production bun main-backend/src/index.ts",
    "build": "bun ex-frontend/build.ts --outdir=dist/ex-frontend && bun build main-backend/src/index.ts --target=bun --outdir=dist/main-backend",
    "test": "bun test",
    "test:core": "bun test detection-core/tests",
    "check-types": "bun test --typecheck"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.3",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0"
  }
}